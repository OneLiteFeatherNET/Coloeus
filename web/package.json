{
  "name": "@onelitefeather/coloeus-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Staff web UI of Coloeus: Nuxt 4 pages served by a Nitro server that is the backend-for-frontend",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "predev": "pnpm theme",
    "dev": "nuxt dev",
    "prebuild": "pnpm theme",
    "build": "nuxt build",
    "theme": "tsx scripts/generate-theme.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../backend/build/classes/java/main/META-INF/swagger/coloeus.yml -o app/types/api.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@material/material-color-utilities": "0.4.0",
    "@vueuse/nuxt": "14.4.0",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "nuxt": "4.5.2",
    "unstorage": "1.17.5",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.96",
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "eslint-plugin-vuejs-accessibility": "2.5.0",
    "happy-dom": "20.11.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
